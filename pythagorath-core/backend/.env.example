# Copy to .env (or export) to point the app at a database.
# Unset → zero-config SQLite dev. Local Postgres or Oman Data Park → set DATABASE_URL.

# Local dev Postgres (docker-compose.postgres.yml):
DATABASE_URL=postgresql+psycopg://pyth:pyth@localhost:5432/pythagorath

# Production (Oman Data Park sovereign Postgres) — data stays in Oman:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST.odp.example.om:5432/pythagorath

DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
