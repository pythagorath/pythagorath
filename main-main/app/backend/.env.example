# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# Anthropic / Claude API — get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Claude model used by curriculum_ai_service (defaults to claude-sonnet-4-6)
CLAUDE_MODEL=claude-sonnet-4-6

# Database connection string (async driver, e.g. postgresql+asyncpg://... or sqlite+aiosqlite:///./app.db)
DATABASE_URL=

# Local development only: bypass JWT auth. NEVER enable in production.
DEV_AUTH_BYPASS=false

# OCR for scanned PDFs (requires the system Tesseract engine + language packs, e.g. 'ara').
OCR_ENABLED=true
OCR_LANGUAGES=ara+eng
OCR_DPI=300
OCR_MAX_PAGES=30
# Path to the tesseract executable if not on PATH (Windows example):
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
